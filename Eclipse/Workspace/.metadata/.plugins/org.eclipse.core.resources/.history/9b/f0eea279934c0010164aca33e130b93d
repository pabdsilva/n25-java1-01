package br.com.senaisp.baur.aula05;

import java.util.Scanner;

public class Exercicio01 {

	public static void main(String[] args) {
		//Usando o scanner para ler um arquvio de texto
		Scanner sc = new Scanner(Exercicio01.class.getResourceAsStream("arquivo.txt"));
		String linha = sc.nextLine(); // pegando cabeçalho
		Scanner sca = new Scanner(linha);
		sca.useDelimiter(";");
		//Imprimindo o cabeçalho
		while(sca.hasNext()) {
			System.out.print(sca.next()+"\t\t");//\t = tab
			
		}
		System.out.println(); //pulando a linha
		sca.close(); //fechando o scanner de apoio
		while(sc.hasNextLine()) {
			linha = sc.nextLine();
			sca = new Scanner(linha);
			sca.useDelimiter(";");//Delimitador
			//Imprimindo o nome
			System.out.println(sca.next()+"\t");//nome
			//Imprimindo a idade
			System.out.println(sca.nextInt() +"\t");//idade
			//Imprimidado o salário
			System.out.println(sca.nextDouble());//salario
			//fechando o scanner
			sca.close();
			
		}
		
	}

}
